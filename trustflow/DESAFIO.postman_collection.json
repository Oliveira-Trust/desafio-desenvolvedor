          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code == 200) {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.environment.set('token', jsonData.token);\r",
                  "    pm.test('Token extraído e salvo na variável de ambiente', function () {\r",
                  "        pm.expect(pm.environment.get('token')).to.eql(jsonData.token);\r",
                  "    });\r",
                  "}else {\r",
                  "    pm.test('Resposta não foi 200 OK', function () {\r",
                  "        pm.expect(pm.response.code).to.eql(200);\r",
                  "    });\r",
                  "}"
                ],
